{
  "name": "baud",
  "version": "0.1.0",
  "description": "Terminal-based MUD/BBS client with Lua scripting support",
  "author": "Jed Northridge",
  "license": "MIT",
  "type": "module",
  "bin": {
    "baud": "./dist/baud"
  },
  "scripts": {
    "dev": "bun run src/main.tsx",
    "build": "bun build src/main.tsx --compile --outfile dist/baud",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "bunx @biomejs/biome check src/",
    "format": "bunx @biomejs/biome format --write src/"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "wasmoon": "^1.16.0",
    "telnet-client": "^2.2.2",
    "ssh2": "^1.16.0",
    "ansi-styles": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/react": "^18.3.12",
    "@types/ssh2": "^1.15.1",
    "bun-types": "latest",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1"
  }
}
